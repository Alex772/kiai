# Copie estes nomes para a aba Variables do Railway.
# Não coloque aspas ao cadastrar os valores no Railway.

# --- Banco de dados (PostgreSQL do Railway) ---
# Dentro do Railway, cole a DATABASE_URL privada gerada pelo proprio servico Postgres.
DATABASE_URL=cole_a_DATABASE_URL_privada_do_servico_postgres_aqui

DISCORD_TOKEN=cole_o_token_do_bot_aqui
DISCORD_CLIENT_ID=cole_o_application_client_id_aqui
DISCORD_GUILD_ID=opcional_id_do_servidor_para_comandos_rapidos
MERCADO_PAGO_PAYER_EMAIL=comprador@example.com
MERCADO_PAGO_ACCESS_TOKEN=cole_o_access_token_do_mercado_pago_aqui

# --- Conexao de contas Mercado Pago por servidor (opcional, multi-servidor) ---
# Pegue em mercadopago.com.br/developers/panel/app -> sua aplicacao -> Editar -> OAuth.
MERCADO_PAGO_CLIENT_ID=opcional_para_multi_servidor
MERCADO_PAGO_CLIENT_SECRET=opcional_para_multi_servidor
# Gere com: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=opcional_mas_obrigatoria_se_usar_mercadopago_conectar
PUBLIC_BASE_URL=https://seu-projeto.up.railway.app
STORE_CURRENCY=BRL
# Cargo com acesso total (equivalente ao dono do servidor). Prefira configurar isso pelo comando
# /permissoes dentro do Discord em vez desta variavel -- ela existe so como redundancia/fallback.
ADMIN_ROLE_ID=opcional_id_do_cargo_admin

# ID do SEU usuario Discord (dono do bot) -- controla o comando /comissao (taxa cobrada
# de servidores conectados via /mercadopago conectar). Ative o modo desenvolvedor no Discord
# e clique com o botao direito no seu proprio nome para copiar o ID.
BOT_OWNER_ID=opcional_seu_id_de_usuario_discord
AUTO_REGISTER_COMMANDS=true

# Recomendado por seguranca: pegue em "Suas integracoes" -> sua app -> Webhooks, no painel do Mercado Pago.
# Sem isso, o bot aceita notificacoes de pagamento sem verificar se vieram mesmo do Mercado Pago.
MERCADO_PAGO_WEBHOOK_SECRET=cole_a_assinatura_secreta_do_painel_do_mercado_pago
