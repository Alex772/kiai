# --- Banco de dados (PostgreSQL do Railway) ---
# Use a DATABASE_URL privada quando o bot roda dentro do Railway (mais rapido, sem custo de egress).
DATABASE_URL=postgresql://postgres:senha@postgres.railway.internal:5432/railway
# Use a DATABASE_PUBLIC_URL apenas para rodar o bot fora do Railway (ex: sua maquina local).
DATABASE_PUBLIC_URL=postgresql://postgres:senha@SEU_PROXY.proxy.rlwy.net:PORTA/railway

DISCORD_TOKEN=coloque_o_token_do_bot
DISCORD_CLIENT_ID=coloque_o_client_id_da_aplicacao
DISCORD_GUILD_ID=opcional_para_registrar_comandos_em_um_servidor
MERCADO_PAGO_PAYER_EMAIL=comprador@example.com
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxx
MERCADO_PAGO_WEBHOOK_SECRET=opcional_se_configurar_assinatura
PUBLIC_BASE_URL=https://seu-projeto.up.railway.app
STORE_CURRENCY=BRL
ADMIN_ROLE_ID=opcional_id_do_cargo_admin
AUTO_REGISTER_COMMANDS=true
